<Window x:Class="CpuBench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cpu-bench" Width="1000" Height="820" MinWidth="840" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <!-- 화면 전체를 85%로: 창·글자·카드가 너무 크다는 의견(2026-11-26). 비율은 그대로 두고 한꺼번에 줄인다. -->
    <DockPanel Margin="18">
        <DockPanel.LayoutTransform>
            <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
        </DockPanel.LayoutTransform>
        <!-- 머리말 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock FontSize="28" FontWeight="Bold"><Run Text="cpu-bench" Foreground="{StaticResource Accent}" /><Run x:Name="VersionRun" Text="" FontSize="14" Foreground="{StaticResource Muted}" FontWeight="Normal" /><Run Text="  내 PC가 제 성능을 내는지 알려 주는 벤치마크" FontSize="16" Foreground="{StaticResource Muted}" FontWeight="Normal" /></TextBlock>
            <!-- 새 버전 알림 (있을 때만 보임) -->
            <Border x:Name="UpdateBanner" Visibility="Collapsed" Margin="0,10,0,0" Padding="14,8" CornerRadius="8"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                <TextBlock FontSize="14">
                    <Run x:Name="UpdateText" Text="" /><Run Text="  " /><Hyperlink Click="Update_Click" Foreground="{StaticResource Accent}">받으러 가기</Hyperlink>
                </TextBlock>
            </Border>
            <TextBlock x:Name="CpuText" Margin="0,8,0,0" FontSize="16" Text="PC 정보를 읽는 중…" />
            <TextBlock x:Name="MemText" Foreground="{StaticResource Muted}" />
        </StackPanel>

        <!-- 아래쪽: 새 버전 확인 설정 -->
        <CheckBox x:Name="UpdateCheckBox" DockPanel.Dock="Bottom" Margin="0,12,0,0" Foreground="{StaticResource Muted}" FontSize="13"
                  Checked="UpdateCheckBox_Changed" Unchecked="UpdateCheckBox_Changed"
                  Content="시작할 때 새 버전 확인 (GitHub에 최신 버전 번호만 물어봅니다. 측정 결과나 PC 정보는 보내지 않습니다)" />

        <!-- 한눈에 보는 상태 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="20,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="22" FontWeight="Bold" VerticalAlignment="Center"><Run x:Name="VerdictIcon" Text="•" /><Run Text="  " /><Run x:Name="VerdictText" Text="" /></TextBlock>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="20,0,0,0">
                        <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource Muted}" Text="제 성능 발휘" />
                        <TextBlock x:Name="PerfText" HorizontalAlignment="Right" FontSize="40" FontWeight="Bold" Text="—" FontFamily="Cascadia Mono, Consolas" />
                        <TextBlock x:Name="PerfDetail" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Muted}" Text="" TextAlignment="Right" />
                    </StackPanel>
                </Grid>
                <ItemsControl x:Name="SummaryCards" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,12,12" Padding="14,12" CornerRadius="8" Background="{StaticResource Bg}" BorderThickness="0,0,0,3" BorderBrush="{Binding Brush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" FontSize="13" />
                                    <TextBlock Text="{Binding Value}" Foreground="{Binding Brush}" FontSize="20" FontWeight="Bold" Margin="0,4,0,4" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="13" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 버튼과 진행 상태 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FullButton" Content="전체 점검 (약 3분 30초)" Click="FullButton_Click" FontSize="17" Padding="26,12" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,14,0" Foreground="{StaticResource Muted}" FontSize="13" Text="하나씩:" />
                <Button x:Name="CheckButton" Content="환경 점검 (3초)" Click="CheckButton_Click" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" FontWeight="Normal" Padding="12,8" />
                <Button x:Name="ScoreButton" Content="점수 측정 (약 2분)" Click="ScoreButton_Click" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" FontWeight="Normal" Padding="12,8" />
                <Button x:Name="ThrottleButton" Content="발열 검사 (1분)" Click="ThrottleButton_Click" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" FontWeight="Normal" Padding="12,8" />
                <Button x:Name="NetButton" Content="인터넷 속도 (20초)" Click="NetButton_Click" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" FontWeight="Normal" Padding="12,8" />
            </StackPanel>
            <ProgressBar x:Name="Progress" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1" Visibility="Hidden"
                         Foreground="{StaticResource Accent}" Background="{StaticResource Panel}" BorderThickness="0" />
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{StaticResource Muted}" Text="측정 중에는 다른 프로그램을 잠시 쉬게 해 두면 결과가 더 정확합니다." />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <!-- 점수 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="점수" FontSize="18" FontWeight="Bold" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="싱글" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="SingleText" Text="—" FontSize="52" FontWeight="Bold" Foreground="{StaticResource Accent}" FontFamily="Cascadia Mono, Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="멀티" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="MultiText" Text="—" FontSize="52" FontWeight="Bold" Foreground="{StaticResource Accent}" FontFamily="Cascadia Mono, Consolas" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl x:Name="ScoreItems" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ScoreWords" Margin="0,10,0,0" FontSize="14" Text="" />
                            <TextBlock x:Name="ClockText" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" Text="" />
                            <TextBlock x:Name="ScoreNote" Margin="0,12,0,0" FontSize="13" Foreground="{StaticResource Muted}"
                                       Text="점수 체계 v2: 항목마다 고정 기준값 대비 비율의 기하평균 × 1000. 기준은 특정 PC가 아니라 고정된 숫자입니다. v2부터 실수 계산(행렬곱·물체 인력)이 들어가서 v1 점수와는 비교할 수 없습니다. 다른 PC와 비교하는 기능은 아직 없습니다." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center"><Run Text="부동소수점" /><Run Text="  점수 v2에 포함" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Muted}" /></TextBlock>
                                <Button x:Name="FpButton" Grid.Column="1" Content="측정 (약 20초)" Click="FpButton_Click" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" FontWeight="Normal" Padding="12,6" />
                            </Grid>
                            <TextBlock x:Name="FpHint" Margin="0,8,0,0" Foreground="{StaticResource Muted}" Text="실수 계산(행렬곱, 물체 사이의 인력 계산) 속도를 잽니다. 점수 측정에도 같은 항목이 들어갑니다(점수 체계 v2). 여기서는 이것만 따로 빠르게 잽니다." TextWrapping="Wrap" />
                            <ItemsControl x:Name="FpItems" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Muted}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="FpWords" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" Text="" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center"><Run Text="멀티코어" /><Run Text="  점수 미반영 · 진단용" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Muted}" /></TextBlock>
                                <Button x:Name="MultiButton" Grid.Column="1" Content="측정 (약 1분)" Click="MultiButton_Click" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" FontWeight="Normal" Padding="12,6" />
                            </Grid>
                            <TextBlock x:Name="MultiHint" Margin="0,8,0,0" Foreground="{StaticResource Muted}" Text="스레드를 1개부터 모든 코어까지 늘리며 얼마나 빨라지는지(확장 곡선)와, 여러 코어가 같은 데이터를 함께 쓸 때 드는 비용을 잽니다. 코어가 많을수록 값이 낮아지는 측정이 섞여 있어 점수에는 넣지 않습니다." TextWrapping="Wrap" />
                            <!-- 확장 곡선: 스레드 수마다 막대 하나, 색은 그 스레드가 앉은 코어 종류 -->
                            <ItemsControl x:Name="ScaleBars" Margin="0,12,0,0" Height="150">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,0" VerticalAlignment="Bottom" ToolTip="{Binding Tip}">
                                            <Rectangle Width="20" Height="{Binding Height}" Fill="{Binding Brush}" RadiusX="3" RadiusY="3" />
                                            <TextBlock Text="{Binding Threads}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ScaleLegend" Margin="0,4,0,0" FontSize="12" Visibility="Collapsed"><Run Text="■ 성능 코어  " Foreground="{StaticResource Good}" /><Run Text="■ 효율 코어  " Foreground="{StaticResource Blue}" /><Run Text="■ 하이퍼스레딩(코어 하나를 둘이 나눠 씀)" Foreground="{StaticResource Accent}" /></TextBlock>
                            <TextBlock x:Name="ScaleWords" Margin="0,8,0,0" Text="" TextWrapping="Wrap" />
                            <ItemsControl x:Name="SyncItems" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Muted}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="MultiWords" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" Text="" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="기록" FontSize="18" FontWeight="Bold" />
                            <TextBlock x:Name="HistoryHint" Margin="0,8,0,0" Foreground="{StaticResource Muted}" Text="점수를 측정하면 이 PC에 기록이 남습니다." />
                            <ItemsControl x:Name="History" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding When}" Foreground="{StaticResource Muted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Single}" FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Grid.Column="2" Text="{Binding Multi}" FontFamily="Cascadia Mono, Consolas" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource Muted}">
                                <Run Text="결과 파일은 이 PC에만 저장됩니다. " /><Hyperlink Click="OpenResults_Click" Foreground="{StaticResource Accent}">폴더 열기</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 진단 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="진단" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="DiagHint" Margin="0,10,0,0" Foreground="{StaticResource Muted}" Text="'환경 점검'이나 '쓰로틀링 검사'를 누르면 결과가 여기에 나옵니다." />
                        <ItemsControl x:Name="Findings" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontSize="20" FontWeight="Bold" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="14" />
                                            <TextBlock Visibility="{Binding LinkVisibility}" FontSize="14" Margin="0,4,0,0">
                                                <Hyperlink Tag="{Binding SettingsUri}" Click="Settings_Click" Foreground="{StaticResource Accent}">설정 열기</Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{StaticResource Muted}"
                                   Text="진단은 읽기만 합니다. 설정을 바꾸거나 프로그램을 종료하지 않고, PC 측정 결과는 어디에도 보내지 않습니다. 인터넷 속도 측정을 누를 때만 M-Lab 서버와 통신합니다." />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
